# Veridex environment template
# Copy to .env and fill in YOUR OWN values locally.
# NEVER commit real secrets. This file lists KEY NAMES ONLY — values stay empty.

# LLM provider API key used by the (future) explanation layer.
VERIDEX_LLM_KEY=

# Market/data provider API key used by the (future) source-citation layer.
VERIDEX_DATA_SOURCE_KEY=

# Optional: deployment region / instance label for the (future) dashboard.
VERIDEX_DEPLOY_REGION=
